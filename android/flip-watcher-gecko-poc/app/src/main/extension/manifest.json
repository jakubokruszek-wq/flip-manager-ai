{
  "manifest_version": 2,
  "name": "Flip Watcher Gecko POC collector",
  "version": "0.2.2",
  "description": "Built-in GeckoView extension: reads post ids of the one approved Facebook group with the unchanged collector-core.js.",
  "browser_specific_settings": {
    "gecko": {
      "id": "flip-gecko-poc@flip-manager.local"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://m.facebook.com/*",
        "https://facebook.com/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "collector-core.js",
        "poc-adapter.js",
        "poc-content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "webRequest",
    "https://*.facebook.com/*",
    "https://facebook.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "poc-adapter.js",
      "poc-background.js"
    ]
  }
}
