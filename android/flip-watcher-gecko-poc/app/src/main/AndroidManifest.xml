<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GeckoView loads pages. OCR uses a bundled local model; only Watcher group metadata can be synchronized with a paired device token. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Stage C local screen-off test only: one short foreground service started by one alarm. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- User-granted ("Alarms & reminders"); without it the test alarm is inexact. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="false"
        android:label="Flip Watcher — Gecko POC"
        android:icon="@android:drawable/ic_menu_search"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".PocActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="stateUnspecified|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ScreenOffAlarmReceiver"
            android:exported="false" />

        <service
            android:name=".ScreenOffTestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
