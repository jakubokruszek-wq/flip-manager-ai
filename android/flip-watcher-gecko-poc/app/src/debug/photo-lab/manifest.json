{
  "manifest_version": 2,
  "name": "LOCAL ONLY photo binding fixture",
  "version": "1.0",
  "browser_specific_settings": {"gecko": {"id": "photo-lab@flip-manager.local"}},
  "permissions": [
    "nativeMessaging", "geckoViewAddons", "webRequest", "webRequestBlocking",
    "http://127.0.0.1/*",
    "https://scontent-fra3-2.xx.fbcdn.net/*"
  ],
  "background": {"scripts": ["background.js"], "persistent": true}
}
